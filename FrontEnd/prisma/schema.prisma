generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueStatus {
  Open
  InProgress
  UnderReview
  Resolved
  Closed
  Reopened
}

model Users {
  UserID          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Username        String    @unique @db.VarChar(255)
  Email           String    @unique @db.VarChar(255)
  PassHash        String?   @db.VarChar(255)
  GHOAuth         String?   @db.VarChar(255)
  Role            String    @default("Developer") @db.VarChar(50)
  CreatedAt       DateTime  @default(now()) @db.Timestamp(6)
  
  SpacesOwned     Space[]   @relation("SpaceOwner")
  Inbox           Inbox[]
  IssuesReported  Issues[]  @relation("IssueReporter")
  IssuesAssigned  Issues[]  @relation("IssueAssignee")
  Comments        Comments[]
  SpaceMembers    SpaceMembers[]
  CommentMentions CommentMentions[]
  AuditLogs       AuditLog[]
}

model Tags {
  TagID    Int        @id @default(autoincrement())
  TagName  String     @unique @db.VarChar(100)
  Issues   IssueTags[]
}

model Space {
  SpaceID     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  OwnerID     String    @db.Uuid
  SpaceName   String    @db.VarChar(255)
  CreatedAt   DateTime  @default(now()) @db.Timestamp(6)
  
  Owner       Users     @relation("SpaceOwner", fields: [OwnerID], references: [UserID], onDelete: Cascade)
  Issues      Issues[]
  Members     SpaceMembers[]
  AuditLogs   AuditLog[]
  Repos       Repo[]
}

model Inbox {
  NotifID     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  UserID      String    @db.Uuid
  NotifTitle  String    @db.VarChar(255)
  NotifDesc   String    @db.Text
  IsRead      Boolean   @default(false)
  CreatedAt   DateTime  @default(now()) @db.Timestamp(6)
  
  User        Users     @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
}

model Repo {
  RepoID        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  SpaceID       String    @db.Uuid
  GHOwner       String    @db.VarChar(255)
  GHName        String    @db.VarChar(255)
  DefaultBranch String    @default("main") @db.VarChar(100)
  ImportedAt    DateTime  @default(now()) @db.Timestamp(6)
  ImportedBy    String    @db.Uuid

  Space         Space     @relation(fields: [SpaceID], references: [SpaceID], onDelete: Cascade)
  Issues        Issues[]
  Commits       Commit[]

  @@unique([SpaceID, GHOwner, GHName])
}

model Commit {
  CommitID      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  RepoID        String    @db.Uuid
  SHA           String    @db.VarChar(40)
  Message       String    @db.Text
  AuthorName    String    @db.VarChar(255)
  AuthorEmail   String?   @db.VarChar(255)
  CommittedAt   DateTime  @db.Timestamp(6)
  URL           String?   @db.VarChar(255)

  Repo          Repo      @relation(fields: [RepoID], references: [RepoID], onDelete: Cascade)
  Issues        Issues[]

  @@unique([RepoID, SHA])
}

model Issues {
  IssueID     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  SpaceID     String      @db.Uuid
  ReporterID  String      @db.Uuid
  AssigneeID  String?     @db.Uuid
  RepoID      String?     @db.Uuid
  CommitID    String?     @db.Uuid
  Title       String      @db.VarChar(255)
  Description String      @db.Text
  Status      IssueStatus @default(Open)
  Severity    String      @default("Medium") @db.VarChar(50)
  BugType     String      @default("Functional") @db.VarChar(50)
  FilePath    String?     @db.VarChar(255)
  LineRange   String?     @db.VarChar(50)
  Environment String?     @db.VarChar(255)
  CreatedAt   DateTime    @default(now()) @db.Timestamp(6)
  UpdatedAt   DateTime    @updatedAt @db.Timestamp(6)
  
  Space       Space       @relation(fields: [SpaceID], references: [SpaceID], onDelete: Cascade)
  Reporter    Users       @relation("IssueReporter", fields: [ReporterID], references: [UserID], onDelete: Cascade)
  Assignee    Users?      @relation("IssueAssignee", fields: [AssigneeID], references: [UserID], onDelete: SetNull)
  Repo        Repo?       @relation(fields: [RepoID], references: [RepoID], onDelete: SetNull)
  Commit      Commit?     @relation(fields: [CommitID], references: [CommitID], onDelete: SetNull)
  Comments    Comments[]
  Tags        IssueTags[]
  AuditLogs   AuditLog[]
}

model Comments {
  CommentID   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  IssueID     String    @db.Uuid
  AuthorID    String    @db.Uuid
  ParentID    String?   @db.Uuid
  Body        String    @db.Text
  CreatedAt   DateTime  @default(now()) @db.Timestamp(6)
  
  Issue       Issues    @relation(fields: [IssueID], references: [IssueID], onDelete: Cascade)
  Author      Users     @relation(fields: [AuthorID], references: [UserID], onDelete: Cascade)
  Parent      Comments? @relation("CommentReplies", fields: [ParentID], references: [CommentID], onDelete: Cascade)
  Replies     Comments[] @relation("CommentReplies")
  Mentions    CommentMentions[]
}

model SpaceMembers {
  SpaceID     String    @db.Uuid
  MemberID    String    @db.Uuid
  Role        String    @db.VarChar(50)
  JoinedAt    DateTime  @default(now()) @db.Timestamp(6)
  
  Space       Space     @relation(fields: [SpaceID], references: [SpaceID], onDelete: Cascade)
  Member      Users     @relation(fields: [MemberID], references: [UserID], onDelete: Cascade)
  
  @@id([SpaceID, MemberID])
}

model IssueTags {
  IssueID     String    @db.Uuid
  TagID       Int
  
  Issue       Issues    @relation(fields: [IssueID], references: [IssueID], onDelete: Cascade)
  Tag         Tags      @relation(fields: [TagID], references: [TagID], onDelete: Cascade)
  
  @@id([IssueID, TagID])
}

model CommentMentions {
  CommentID       String    @db.Uuid
  MentionedUserID String    @db.Uuid
  
  Comment         Comments  @relation(fields: [CommentID], references: [CommentID], onDelete: Cascade)
  MentionedUser   Users     @relation(fields: [MentionedUserID], references: [UserID], onDelete: Cascade)
  
  @@id([CommentID, MentionedUserID])
}

model AuditLog {
  AuditID     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  UserID      String    @db.Uuid
  SpaceID     String    @db.Uuid
  IssueID     String?   @db.Uuid
  AuditTitle  String    @db.VarChar(255)
  AuditDesc   String    @db.Text
  AuditTime   DateTime  @default(now()) @db.Timestamp(6)
  
  User        Users     @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
  Space       Space     @relation(fields: [SpaceID], references: [SpaceID], onDelete: Cascade)
  Issue       Issues?   @relation(fields: [IssueID], references: [IssueID], onDelete: SetNull)
}
